# ---------------------------------------------------------------- database
# Local dev: run `npx prisma dev -d -n kickoff`, then use the TCP URL that
# `npx prisma dev ls` prints (postgres://...), NOT the prisma+postgres:// one.
# Deployment: a Neon pooled connection string.
# Migrations run through this same URL, so no separate DIRECT_URL is needed.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"

# ------------------------------------------------------------------- auth
# Signs the session JWT. At least 32 characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""


# --------------------------------------------------------------------- ai
# Optional. Without it the AI copilot falls back to deterministic summaries.
ANTHROPIC_API_KEY=""
# Optional model override; defaults to claude-opus-5.
ANTHROPIC_MODEL=""
